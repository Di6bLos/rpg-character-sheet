{
  "aasimar": {
    "summary": "A mortal carrying a spark of celestial power: resists necrotic and radiant harm, sees in the dark, heals with a touch, and from level 3 can briefly take on a glowing or shadowy form.",
    "traits": [
      {
        "name": "Celestial Resistance",
        "summary": "Resistance to both Necrotic and Radiant damage.",
        "grants": [
          {
            "kind": "resistance",
            "value": "Necrotic"
          },
          {
            "kind": "resistance",
            "value": "Radiant"
          }
        ]
      },
      {
        "name": "Darkvision",
        "summary": "See in darkness out to 60 ft.",
        "grants": [
          {
            "kind": "sense",
            "value": "Darkvision",
            "range": 60
          }
        ]
      },
      {
        "name": "Healing Hands",
        "summary": "Magic action: touch a creature and it regains HP equal to a roll of d4s, one die per point of PB. Once per Long Rest.",
        "activation": "magic",
        "uses": {
          "count": 1,
          "recharge": "long"
        },
        "range": "Touch"
      },
      {
        "name": "Light Bearer",
        "summary": "Know the Light cantrip; cast it with CHA.",
        "grants": [
          {
            "kind": "spell",
            "spell": "light"
          }
        ]
      },
      {
        "name": "Celestial Revelation",
        "level": 3,
        "summary": "From level 3, Bonus Action: transform for 1 minute (end it any time, no action) in one of three forms, picked each time. Once per Long Rest. While transformed, once per turn add PB damage to one target you damage with an attack or spell.",
        "activation": "bonus",
        "uses": {
          "count": 1,
          "recharge": "long"
        },
        "duration": "1 minute",
        "options": [
          {
            "name": "Heavenly Wings",
            "summary": "Gain a Fly Speed matching your Speed; the extra damage is Radiant.",
            "damageType": "Radiant",
            "grants": [
              {
                "kind": "speed",
                "value": "fly",
                "amount": "walk"
              }
            ]
          },
          {
            "name": "Inner Radiance",
            "summary": "Shed Bright Light 10 ft and Dim Light 10 ft beyond; each creature within 10 ft takes Radiant damage equal to PB at the end of each of your turns. Extra damage is Radiant.",
            "damageType": "Radiant",
            "range": 10
          },
          {
            "name": "Necrotic Shroud",
            "summary": "On transforming, non-allies within 10 ft make a CHA save (DC 8 + PB + CHA) or are Frightened until your next turn ends. Extra damage is Necrotic.",
            "damageType": "Necrotic",
            "range": 10,
            "save": {
              "ability": "CHA",
              "dc": "8+PB+CHA"
            },
            "duration": "until the end of your next turn"
          }
        ]
      }
    ]
  },
