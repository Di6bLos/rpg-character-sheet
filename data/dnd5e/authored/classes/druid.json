              "at": 9
            },
            {
              "kind": "spell",
              "spell": "hold-monster",
              "at": 9
            }
          ]
        },
        "Wrath of the Sea": {
          "summary": "Bonus Action, spend a Wild Shape use: a 5-ft spray aura around you for 10 min. On creation and as a later Bonus Action, one creature in it makes a CON save or takes (WIS mod, min 1)d6 Cold; Large or smaller is shoved up to 15 ft.",
          "activation": "bonus",
          "range": 5,
          "duration": "10 minutes",
          "damageType": "Cold",
          "save": {
            "ability": "CON",
            "dc": "spell"
          }
        },
        "Aquatic Affinity": {
          "summary": "The Wrath of the Sea aura grows to 10 ft, and you swim at your walking Speed.",
          "grants": [
            {
              "kind": "speed",
              "value": "swim",
              "amount": "walk"
            }
          ]
        },
        "Stormborn": {
          "summary": "While Wrath of the Sea is up, you fly at your Speed and resist Cold, Lightning and Thunder."
        },
        "Oceanic Gift": {
          "summary": "You may center Wrath of the Sea on a willing creature within 60 ft; it uses your save DC and WIS. Spending two Wild Shape uses gives the aura to both of you.",
          "range": 60
        }
      }
    },
    "circle-of-the-stars": {
      "summary": "A stargazer who carries a star chart, reads daily omens and takes on a glowing constellation form.",
      "features": {
        "Star Map": {
          "summary": "You own a Tiny star chart that works as a Druid focus. Holding it, you have Guidance and Guiding Bolt prepared and cast Guiding Bolt slot-free WIS mod times (min 1) per Long Rest. Remake a lost one in a 1-hour rite during a rest.",
          "grants": [
            {
              "kind": "spell",
              "spell": "guidance",
              "at": 3
            },
            {
              "kind": "spell",
              "spell": "guiding-bolt",
              "at": 3,
              "free": {
                "count": "WIS",
                "recharge": "long"
              }
            }
          ]
        },
        "Starry Form": {
          "summary": "Bonus Action, spend a Wild Shape use: glow for 10 min (bright light 10 ft, dim 10 ft past that) and keep your own stats instead of changing shape. Each time, pick a constellation: Archer, Chalice or Dragon.",
          "activation": "bonus",
          "duration": "10 minutes",
          "options": [
            {
              "name": "Archer",
              "summary": "When you take the form and as a Bonus Action later: ranged spell attack vs one creature within 60 ft, 1d8 + WIS Radiant.",
              "activation": "bonus",
              "range": 60,
              "dice": "1d8",
              "damageType": "Radiant"
            },
            {
              "name": "Chalice",
              "summary": "When a spell cast with a slot heals someone, you or a creature within 30 ft also heals 1d8 + WIS.",
              "range": 30,
              "dice": "1d8"
            },
            {
              "name": "Dragon",
              "summary": "On INT or WIS checks and CON saves to hold Concentration, a d20 of 9 or less counts as 10."
            }
          ]
        },
        "Cosmic Omen": {
          "summary": "After each Long Rest roll a die: even means Weal, odd means Woe until your next one. Reaction when a creature you see within 30 ft makes a D20 Test: roll 1d6 to add (Weal) or subtract (Woe). WIS mod uses (min 1) per Long Rest.",
          "activation": "reaction",
          "range": 30,
          "dice": "1d6",
          "uses": {
            "count": "WIS",
            "recharge": "long"
          },
          "options": [
            {
              "name": "Weal",
              "summary": "Even roll: your 1d6 goes onto the creature's D20 Test."
            },
            {
              "name": "Woe",
              "summary": "Odd roll: your 1d6 comes off the creature's D20 Test."
            }
          ]
        },
        "Twinkling Constellations": {
          "summary": "Archer and Chalice roll 2d8 instead of 1d8; with Dragon you fly 20 ft and can hover. At the start of each of your turns in Starry Form you may switch constellation.",
          "dice": "2d8"
        },
        "Full of Stars": {
          "summary": "In Starry Form you resist Bludgeoning, Piercing and Slashing damage."
        }
      }
    }
