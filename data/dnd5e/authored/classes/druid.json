    "circle-of-the-moon": {
      "summary": "A shape-shifter whose lunar magic makes Wild Shape forms tougher, deadlier and able to cast circle spells.",
      "features": {
        "Circle Forms": {
          "summary": "Shape-shifted, your top form CR is Druid level ÷ 3 (round down), your AC is the beast's or 13 + WIS, whichever is higher, and you get temp HP of 3 × Druid level."
        },
        "Circle of the Moon Spells": {
          "summary": "Always prepared: Cure Wounds, Moonbeam, Starry Wisp at 3; Conjure Animals at 5; Fount of Moonlight at 7; Mass Cure Wounds at 9. These work even in Wild Shape.",
          "grants": [
            {
              "kind": "spell",
              "spell": "cure-wounds",
              "at": 3
            },
            {
              "kind": "spell",
              "spell": "moonbeam",
              "at": 3
            },
            {
              "kind": "spell",
              "spell": "starry-wisp",
              "at": 3
            },
            {
              "kind": "spell",
              "spell": "conjure-animals",
              "at": 5
            },
            {
              "kind": "spell",
              "spell": "fount-of-moonlight",
              "at": 7
            },
            {
              "kind": "spell",
              "spell": "mass-cure-wounds",
              "at": 9
            }
          ]
        },
        "Improved Circle Forms": {
          "summary": "In beast form, each hit can deal Radiant instead of its usual type (pick per hit), and you add WIS to CON saves."
        },
        "Moonlight Step": {
          "summary": "Bonus Action: teleport up to 30 ft to a space you see; your next attack roll this turn has Advantage. WIS mod uses (min 1) per Long Rest; a level 2+ slot buys back one use.",
          "activation": "bonus",
          "range": 30,
          "uses": {
            "count": "WIS",
            "recharge": "long",
            "restore": "a level 2+ spell slot per use"
          }
        },
        "Lunar Form": {
          "summary": "Once per turn a beast-form hit adds 2d10 Radiant. Moonlight Step can bring a willing creature within 10 ft along, setting it down within 10 ft of where you arrive.",
          "uses": {
            "count": 1,
            "recharge": "turn"
          },
          "dice": "2d10",
          "damageType": "Radiant"
        }
      }
    },
    "circle-of-the-sea": {
      "summary": "A storm-caller who spends Wild Shape on a freezing aura of sea spray that batters foes.",
      "features": {
        "Circle of the Sea Spells": {
          "summary": "Always-prepared spells by Druid level. 3: Thunderwave, Ray of Frost, Fog Cloud, Gust of Wind. 5: Water Breathing, Lightning Bolt. 7: Ice Storm, Control Water. 9: Hold Monster, Conjure Elemental.",
          "grants": [
            {
              "kind": "spell",
              "spell": "fog-cloud",
